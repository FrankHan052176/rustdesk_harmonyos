
{
  "apiType": 'stageMode',
  "buildOption": {
    "resOptions": {
      // HarmonyOS uses setKeepScreenOn; this wakelock_plus asset is Web-only.
      "ignoreResourcePattern": [
        "no_sleep.js"
      ]
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "publish",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest",
    }
  ]
}
